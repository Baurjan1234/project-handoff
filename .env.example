# Copy to .env for app config. NEVER commit the filled-in file. Hard rule 2.
#
# HEDERA_ACCOUNT_ID must ALSO be exported in your shell profile, because .mcp.json
# expands it from the environment and does not read .env:
#
#     export HEDERA_ACCOUNT_ID=0.0.xxxxxx
#
# Hard rule 5: testnet only. No mainnet values in this file, ever.

# Your own testnet account, from https://portal.hedera.com/
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet

X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
X402_PAYER_ACCOUNT_ID=0.0.xxxxxx
X402_PAYER_PRIVATE_KEY=
X402_RECEIVER_ACCOUNT_ID=0.0.xxxxxx
X402_FEE_TINYBARS=

HANDOFF_SERVICE_URL=

# Mirror node the apps read settlement state from
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1

# Content store. The service key is vault-only and belongs to P1's shared project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Which seat you are, for the AI usage log. P1, P2, P3 or P4.
HANDOFF_SEAT=
