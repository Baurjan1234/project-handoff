# Copy to .env for app config. NEVER commit the filled-in file. Hard rule 2.
#
# HEDERA_ACCOUNT_ID must ALSO be exported in your shell profile, because .mcp.json
# expands it from the environment and does not read .env:
#
#     export HEDERA_ACCOUNT_ID=0.0.xxxxxx
#
# Hard rule 5: testnet only. No mainnet values in this file, ever.

# Your own testnet account, from https://portal.hedera.com/
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet

# The shared escrow account and the two platform keys (NAS-12). Provisioned ONCE by
# packages/chain/scripts/provision-escrow.ts — ask P1 for the current values rather
# than running it again, or you get a second escrow and a split ledger story.
#
# 2-of-3 KeyList: requester (the demo requester's session key) + verifier +
# schedule-admin. Verifier + schedule-admin is the payout path, which is why the
# platform can pay without the requester; requester + either platform key is the
# clawback path.
#
# THE VAULT IS THESE TWO KEYS' REAL HOME, per the "Where things live" table — the
# operator and service keys live there and nowhere else, and these are the same class
# of secret. This file is the local dev stand-in only.
HEDERA_ESCROW_ACCOUNT_ID=
HEDERA_VERIFIER_KEY=
HEDERA_SCHEDULE_ADMIN_KEY=

X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
X402_PAYER_ACCOUNT_ID=0.0.xxxxxx
X402_PAYER_PRIVATE_KEY=
X402_RECEIVER_ACCOUNT_ID=0.0.xxxxxx
X402_FEE_TINYBARS=

HANDOFF_SERVICE_URL=

# Mirror node the apps read settlement state from
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1

# Content store. The service key is vault-only and belongs to P1's shared project.
# Note Supabase renamed these: the dashboard's "secret key" (sb_secret_...) is what
# goes in SUPABASE_SERVICE_KEY, and its "publishable key" (sb_publishable_...) is
# SUPABASE_ANON_KEY. Only URL + SERVICE_KEY are actually read today.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Private bucket for artifacts and notes. Created by
# packages/content/scripts/verify-supabase.ts if it does not exist yet.
SUPABASE_BUCKET=handoff-content

# Which seat you are, for the AI usage log. P1, P2, P3 or P4.
HANDOFF_SEAT=

# HCS topics (NAS-13). Provisioned on testnet 2026-09-08 by
# packages/chain/scripts/provision-topics.ts — ask P1 for the current ids rather than
# creating your own, or your app reads an empty topic while everyone else reads the
# real one. Verified with packages/chain/scripts/verify-topics.ts.
#
#   orders, attestations  no submit key, no admin key — experts publish claims and
#                         attestations from their OWN accounts, and nothing (including
#                         us) can delete the record
#   registry              submit key + admin key — platform-written only; the refusal
#                         is confirmed against testnet, not assumed
HANDOFF_ORDERS_TOPIC_ID=
HANDOFF_ATTESTATIONS_TOPIC_ID=
HANDOFF_REGISTRY_TOPIC_ID=

# Credential tags this build routes to, as code=Label pairs. The registry owns this once NAS-27 lands.
HANDOFF_CERT_TAGS=cpa-us=Licensed reviewer