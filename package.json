{
  "name": "handoff",
  "version": "0.0.0",
  "private": true,
  "description": "Agents do the work. A certified human stands behind it.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "prepublishOnly": "echo '\n  This is the workspace root, not a publishable package.\n  The only package we publish is the client:  pnpm publish:client\n' && exit 1",
    "publish:client": "pnpm --filter @hedera-handoff/mcp-client exec npm publish",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@hiero-ledger/sdk": "2.85.0"
    }
  }
}
