{
  "mcpServers": {
    "handoff": {
      "command": "npx",
      "args": [
        "-y",
        "@hedera-handoff/mcp-client"
      ],
      "env": {
        "HANDOFF_SERVICE_URL": "${HANDOFF_SERVICE_URL}",
        "X402_PAYER_ACCOUNT_ID": "${X402_PAYER_ACCOUNT_ID}",
        "X402_PAYER_PRIVATE_KEY": "${X402_PAYER_PRIVATE_KEY}"
      }
    },
    "hedera": {
      "type": "http",
      "url": "https://agentic-testnet-mcp.hedera.com/mcp",
      "headers": {
        "x-hedera-account-id": "${HEDERA_ACCOUNT_ID}"
      }
    },
    "hedera-docs": {
      "type": "http",
      "url": "https://docs.hedera.com/mcp"
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
